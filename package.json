    "@codemirror/view": "^6.39.16",
    "@types/node": "^24.5.2",
    "esbuild": "^0.25.9",
    "marked": "^18.0.14",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "playwright": "^1.63.0"
  }
